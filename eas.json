{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "production:scope-and-stride": {
      "extends": "production",
      "env": {
        "BRAND_SLUG": "scope-and-stride"
      }
    },
    "production:hidden-hill-farm": {
      "extends": "production",
      "env": {
        "BRAND_SLUG": "hidden-hill-farm"
      }
    },
    "production:hidden-hill-farm:android": {
      "extends": "production:hidden-hill-farm",
      "env": {
        "BRAND_SLUG": "hidden-hill-farm"
      }
    }
  },
  "submit": {
    "production": {},
    "production:hidden-hill-farm": {
      "ios": {
        "ascAppId": "6808262044"
      }
    },
    "production:hidden-hill-farm:android": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
